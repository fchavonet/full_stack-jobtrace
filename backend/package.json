{
  "name": "jobtrace-backend",
  "version": "0.1.0",
  "description": "JobTrace - Backend",
  "author": "Fabien Chavonet",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23",
    "npm": ">=10"
  },
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset",
    "prisma:status": "prisma migrate status",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "test": "cross-env NODE_ENV=test vitest run --fileParallelism=false --slowTestThreshold=1000",
    "test:verbose": "cross-env NODE_ENV=test vitest run --fileParallelism=false --reporter=verbose",
    "test:watch": "cross-env NODE_ENV=test vitest --fileParallelism=false",
    "test:coverage": "cross-env NODE_ENV=test vitest run --fileParallelism=false --coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "nodemon": "^3.1.11",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.9"
  }
}
