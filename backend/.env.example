NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://jobtrace_user:jobtrace_password@host.docker.internal:5432/jobtrace_db

JWT_SECRET=change_this_secret_in_development
JWT_EXPIRES_IN=1d

AUTH_COOKIE_NAME=jobtrace_auth
AUTH_COOKIE_MAX_AGE=86400000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="JobTrace <no-reply@jobtrace.local>"
SMTP_SECURE=false
FRONTEND_URL=http://localhost:3000
